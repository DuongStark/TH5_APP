{
  "name": "ReactNative",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . && npm run lint:web",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "emulators": "npx --yes firebase-tools@14.22.0 emulators:start --project demo-may-chat --only auth,database",
    "test:firebase": "npx --yes firebase-tools@14.22.0 emulators:exec --project demo-may-chat --only auth,database \"node --test --test-force-exit tests/firebase.integration.cjs\"",
    "web": "node web/server.cjs",
    "test:web": "node --test web/tests/*.test.mjs",
    "lint:web": "eslint web --ext .mjs,.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/geolocation": "3.4.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "firebase": "13.1.0",
    "lucide-react-native": "^1.57.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.30.0",
    "react-native-svg": "^15.15.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
