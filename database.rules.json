{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth !== null",
      "$uid": {
        ".write": "auth !== null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['name'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "presence": {
      ".read": "auth !== null",
      "$uid": {
        "connections": {
          "$connection": {
            ".write": "auth !== null && auth.uid === $uid",
            ".validate": "newData.val() === true"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        "$chatId": {
          ".write": "auth !== null && (root.child('chats').child($chatId).child('members/first').val() === auth.uid || root.child('chats').child($chatId).child('members/second').val() === auth.uid) && (auth.uid === $uid || auth.uid === newData.val()) && newData.isString() && ((root.child('chats').child($chatId).child('members/first').val() === $uid && root.child('chats').child($chatId).child('members/second').val() === newData.val()) || (root.child('chats').child($chatId).child('members/second').val() === $uid && root.child('chats').child($chatId).child('members/first').val() === newData.val()))"
        }
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth !== null && (data.child('members/first').val() === auth.uid || data.child('members/second').val() === auth.uid)",
        "members": {
          ".read": "auth !== null",
          ".write": "auth !== null && newData.exists() && (!data.exists() || (newData.child('first').val() === data.child('first').val() && newData.child('second').val() === data.child('second').val())) && (newData.child('first').val() === auth.uid || newData.child('second').val() === auth.uid)",
          ".validate": "newData.hasChildren(['first', 'second']) && newData.child('first').val() !== newData.child('second').val() && $chatId === newData.child('first').val() + '_' + newData.child('second').val()",
          "first": {
            ".validate": "newData.isString() && root.child('users').child(newData.val()).exists()"
          },
          "second": {
            ".validate": "newData.isString() && root.child('users').child(newData.val()).exists()"
          },
          "$other": {
            ".validate": false
          }
        },
        "messages": {
          ".indexOn": ["createdAt"],
          "$messageId": {
            ".write": "auth !== null && (root.child('chats').child($chatId).child('members/first').val() === auth.uid || root.child('chats').child($chatId).child('members/second').val() === auth.uid) && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['senderId', 'type', 'text', 'createdAt']) && (newData.child('type').val() === 'text' || newData.hasChildren(['latitude', 'longitude']))",
            "senderId": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "type": {
              ".validate": "newData.val() === 'text' || newData.val() === 'location'"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000 && newData.val().replace(' ', '').replace('\\n', '').replace('\\r', '').replace('\\t', '').length > 0"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "latitude": {
              ".validate": "newData.parent().child('type').val() === 'location' && newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "longitude": {
              ".validate": "newData.parent().child('type').val() === 'location' && newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "receipts": {
          "$uid": {
            "$messageId": {
              ".write": "auth !== null && auth.uid === $uid && (root.child('chats').child($chatId).child('members/first').val() === auth.uid || root.child('chats').child($chatId).child('members/second').val() === auth.uid) && newData.val() === true && root.child('chats').child($chatId).child('messages').child($messageId).exists() && root.child('chats').child($chatId).child('messages').child($messageId).child('senderId').val() !== auth.uid"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
